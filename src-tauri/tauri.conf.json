{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FinanceWizard",
  "version": "../package.json",
  "identifier": "com.financewizard.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "FinanceWizard",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVENjA2RDgxQTBGNEI0MEYKUldRUHRQU2dnVzFnWGJLNlpmQS9BdW56dnB0d2NqenRlRHhqaU8wRTVMQjhFU3VYRlVmbGVENU4K",
      "endpoints": ["https://github.com/MeloSendra/FinanceWizard/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
